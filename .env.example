# Base URL of the support-portal API (the gcp/ cloud function in the main repo).
# Injected at build time; both panels read it through lib/api.ts.
NEXT_PUBLIC_API_BASE=https://asia-south1-ibproduct-vibe-coding.cloudfunctions.net

# Google Identity Services client id, used by the panels' SSO sign-in.
# Only the admin panels ever loaded GIS; the public site does not need it.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
